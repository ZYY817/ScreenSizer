<Window x:Class="ScreenSizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ScreenSizer.Controls"
        Title="AimFrame 准框" Width="880" Height="620"
        Icon="pack://application:,,,/Assets/AimFrame.ico"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 点阵底纹 -->
        <DrawingBrush x:Key="DotGrid" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute" Viewbox="0,0,14,14" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource DotBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,14,14"/>
                            <EllipseGeometry Center="7,7" RadiusX="1" RadiusY="1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 黑边斜线 -->
        <DrawingBrush x:Key="Hatch" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute" Viewbox="0,0,7,7" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#12FFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><LineGeometry StartPoint="0,7" EndPoint="7,0"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="Corner" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>
        <Style x:Key="Fact" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="FactDot" TargetType="Rectangle">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="45"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="FactText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="StepTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="AboutDot" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="d" Width="5" Height="5" Fill="{DynamicResource Text3Brush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <TextBlock x:Name="lbl" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource NumFont}" FontSize="10"
                                       Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,24,0" Visibility="Hidden" ClipToBounds="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="d" Property="Width" Value="8"/>
                                <Setter TargetName="d" Property="Height" Value="8"/>
                                <Setter TargetName="d" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="lbl" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="d" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="d" Property="StrokeThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="RootGrid" MouseMove="Root_MouseMove" MouseLeave="Root_MouseLeave">

            <!-- ================= 艺术底层 ================= -->
            <Rectangle Fill="{StaticResource DotGrid}" IsHitTestVisible="False"/>
            <!-- Canvas 不做布局裁剪：放在 Grid 里的超大椭圆会被裁成矩形，移动时露出硬边 -->
            <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="Glow" Width="640" Height="560" Canvas.Left="380" Canvas.Top="-260" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="GlowT"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- 鼠标聚光已移除：大面积随鼠标重绘会导致整窗闪烁 -->
            </Canvas>

            <!-- ================= 主体 ================= -->
            <Grid x:Name="MainContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="6" VerticalAlignment="Bottom" Style="{StaticResource RowLine}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,28,0" VerticalAlignment="Center">
                        <Canvas Width="22" Height="22">
                            <Path Data="M1,7 V1 H7 M15,1 H21 V7 M21,15 V21 H15 M7,21 H1 V15" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="7.5" Canvas.Top="9" Width="7" Height="4" Fill="{DynamicResource AccentBrush}"/>
                        </Canvas>
                        <c:TrackedText Text="AIM" FontSize="14" FontWeight="Bold" Tracking="0.2" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <c:TrackedText Text="FRAME" FontSize="14" FontWeight="Light" Tracking="0.2" Margin="3,0,0,0"
                                       Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="NavScale" FocusVisualStyle="{x:Null}" Style="{StaticResource NavRadio}" Content="缩放" Tag="Scale" Checked="Nav_Checked" IsChecked="True"/>
                        <RadioButton x:Name="NavSettings" FocusVisualStyle="{x:Null}" Style="{StaticResource NavRadio}" Content="设置" Tag="Settings" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAbout" FocusVisualStyle="{x:Null}" Style="{StaticResource NavRadio}" Tag="About" AutomationProperties.Name="关于" Checked="Nav_Checked">
                            <Grid>
                                <TextBlock Text="关于"/>
                                <Ellipse x:Name="UpdateDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-9,0" Visibility="Collapsed"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse x:Name="GpuDot" Width="6" Height="6" Fill="{DynamicResource GpuOkBrush}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="GpuText" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="MonitorCombo" Grid.Column="4" Style="{StaticResource MonitorCombo}" MinWidth="200"
                              VerticalAlignment="Center" SelectionChanged="MonitorCombo_SelectionChanged"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Style="{StaticResource TitleBtn}" Content="─" Click="Min_Click"/>
                        <Button Style="{StaticResource TitleBtnClose}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 状态条 -->
                <Border x:Name="StatusBar" Grid.Row="1" Margin="20,14,20,0" Height="38" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" ClipToBounds="True">
                    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StatusTag" Background="{DynamicResource Surface2Brush}" Padding="12,0" CornerRadius="5,0,0,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusTagDot" Width="6" Height="6" Fill="{DynamicResource Text3Brush}" Margin="0,0,7,0"/>
                                <c:TrackedText x:Name="StatusTagText" Text="READY" FontSize="11" FontWeight="SemiBold" Tracking="0.16"
                                               Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StatusMsg" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button x:Name="StatusLogLink" Style="{StaticResource LinkBtn}" Content="查看日志" FontSize="11"
                                    Margin="0,0,8,0" Padding="0" VerticalAlignment="Center" Visibility="Collapsed" Click="StatusLog_Click"/>
                            <StackPanel x:Name="StatusKbd" Orientation="Horizontal"/>
                            <TextBlock Text=" 应用 / 还原" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle x:Name="StatusSweep" Grid.ColumnSpan="3" Width="260" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{DynamicResource AccentClearColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0.5"/>
                                    <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform><TranslateTransform x:Name="StatusSweepT"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>

                <!-- ================= 页面 ================= -->
                <Grid x:Name="Pages" Grid.Row="2">

                    <!-- ============ 缩放页 ============ -->
                    <Grid x:Name="PageScale" Margin="20,18,20,18">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="404"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：控制 -->
                        <Grid x:Name="LeftCol" Grid.Column="0">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <!-- 背景描边大数字：数字与 ″ 各自固定坐标，数字变短（如 24″）时 ″ 不会左移压住徽标 -->
                            <Canvas IsHitTestVisible="False">
                            <Canvas x:Name="Ghost" Canvas.Left="-36" Canvas.Top="34">
                                <Canvas.CacheMode><BitmapCache EnableClearType="False" SnapsToDevicePixels="False"/></Canvas.CacheMode>
                                <Canvas.RenderTransform><TranslateTransform x:Name="GhostT"/></Canvas.RenderTransform>
                                <c:OutlineText x:Name="GhostNum" Text="24.5" FontSize="290" FontWeight="Bold" Stroke="{DynamicResource GhostStrokeBrush}"/>
                                <c:OutlineText Text="″" Canvas.Left="560" FontSize="290" FontWeight="Bold" Stroke="{DynamicResource AccentLineBrush}" Opacity="0.6"/>
                            </Canvas>
                            </Canvas>

                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <c:TrackedText Style="{StaticResource Cap}" Prefix="01" Text="MODE" HorizontalAlignment="Left"/>
                                    <Border Style="{StaticResource SegTrack}" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SegScreen" FocusVisualStyle="{x:Null}" Style="{StaticResource SegRadio}" GroupName="mode" Content="整个屏幕" Checked="Mode_Checked" IsChecked="True"/>
                                            <RadioButton x:Name="SegWindow" FocusVisualStyle="{x:Null}" Style="{StaticResource SegRadio}" GroupName="mode" Content="仅游戏窗口" Checked="Mode_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid><!-- 两个面板叠放在同一格，各自都能撑满 -->
                                <!-- 整个屏幕 -->
                                <DockPanel x:Name="ScreenPanel">
                                    <Grid DockPanel.Dock="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="MainBtn" Style="{StaticResource PrimaryBtn}" Click="Main_Click">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock x:Name="MainIco" Text="▶" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="MainLabel" VerticalAlignment="Center"/>
                                                <StackPanel x:Name="MainBtnKbd" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0.65" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Button>
                                        <Button x:Name="SecBtn" Grid.Column="1" Style="{StaticResource SecBtn}" Content="还原" Height="50"
                                                Margin="8,0,0,0" Click="Restore_Click" Visibility="Collapsed"/>
                                    </Grid>

                                    <StackPanel>
                                        <c:TrackedText Style="{StaticResource Cap}" Prefix="02" Text="TARGET SIZE" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                                        <Grid Margin="0,2,0,0" Height="92">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Grid>
                                                    <TextBlock x:Name="GlitchA" Text="{Binding Text, ElementName=InchText}" FontFamily="{StaticResource NumLightFont}"
                                                               FontSize="96" Foreground="{DynamicResource AccentBrush}" Opacity="0">
                                                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock x:Name="GlitchB" Text="{Binding Text, ElementName=InchText}" FontFamily="{StaticResource NumLightFont}"
                                                               FontSize="96" Foreground="#00E5FF" Opacity="0">
                                                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock x:Name="InchText" Text="24.5" FontFamily="{StaticResource NumLightFont}" FontSize="96"
                                                               Margin="0,-14,0,0" Foreground="{DynamicResource TextBrush}"/>
                                                </Grid>
                                                <TextBlock Text="″" FontFamily="{StaticResource NumLightFont}" FontSize="36" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                            </StackPanel>
                                            <Border x:Name="Badge" c:Cut.Size="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0"
                                                    Padding="10,5,12,5" Background="{DynamicResource AccentBrush}">
                                                <c:TrackedText x:Name="BadgeText" Text="PRO STANDARD" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentInkBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="SubText" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" Margin="0,6,0,0"/>

                                        <c:RulerControl x:Name="Ruler" Margin="0,16,0,0"
                                                        TickBrush="{DynamicResource Line2Brush}" StrongBrush="{DynamicResource TextBrush}"
                                                        LabelBrush="{DynamicResource Text3Brush}" AccentBrush="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="SnapHint" FontSize="11" Foreground="{DynamicResource Text3Brush}"
                                                   Margin="0,4,0,0" Visibility="Collapsed"/>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="3" Style="{StaticResource RowLine}" VerticalAlignment="Top"/>
                                            <StackPanel Margin="0,10,0,0">
                                                <c:TrackedText Style="{StaticResource Cap}" Text="RESOLUTION" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="RoRes" Style="{StaticResource ReadoutValue}" Text="2356×1326"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}" Margin="0,10,0,0" Padding="14,0,0,0">
                                                <StackPanel>
                                                    <c:TrackedText Style="{StaticResource Cap}" Text="SCALE" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="RoScale" Style="{StaticResource ReadoutValue}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}" Margin="0,10,0,0" Padding="14,0,0,0">
                                                <StackPanel>
                                                    <c:TrackedText Style="{StaticResource Cap}" Text="BORDER" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="RoBorder" Style="{StaticResource ReadoutValue}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <WrapPanel x:Name="ProfilePanel" Margin="0,14,0,0">
                                            <TextBlock Text="我的配置" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        </WrapPanel>
                                        <ToggleButton x:Name="AdvToggle" Style="{StaticResource AdvToggle}" Content="按分辨率选择" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                        <WrapPanel x:Name="ResPanel" Margin="0,8,0,0"
                                                   Visibility="{Binding IsChecked, ElementName=AdvToggle, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 仅游戏窗口 -->
                                <DockPanel x:Name="WindowPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <!-- 目标尺寸：与「整个屏幕」共用同一个值（双向绑定主刻度尺） -->
                                    <Grid DockPanel.Dock="Top">
                                        <c:TrackedText Style="{StaticResource Cap}" Prefix="02" Text="TARGET SIZE" HorizontalAlignment="Left"/>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Run x:Name="WinSizeText" Text="24.5" FontFamily="{StaticResource NumLightFont}" FontSize="26"/><Run Text="″" FontFamily="{StaticResource NumLightFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}"/><Run x:Name="WinResText" Text="  3464×1948" FontFamily="{StaticResource NumFont}" FontSize="11.5" Foreground="{DynamicResource Text3Brush}"/>
                                        </TextBlock>
                                    </Grid>
                                    <c:RulerControl x:Name="WinRuler" DockPanel.Dock="Top" Margin="0,2,0,0"
                                                    Value="{Binding Value, ElementName=Ruler, Mode=TwoWay}"
                                                    Minimum="{Binding Minimum, ElementName=Ruler}" Maximum="{Binding Maximum, ElementName=Ruler}"
                                                    SelectedPreset="{Binding SelectedPreset, ElementName=Ruler}"
                                                    TickBrush="{DynamicResource Line2Brush}" StrongBrush="{DynamicResource TextBrush}"
                                                    LabelBrush="{DynamicResource Text3Brush}" AccentBrush="{DynamicResource AccentBrush}"/>
                                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                                        <c:TrackedText Style="{StaticResource Cap}" Prefix="03" Text="GAME WINDOW" HorizontalAlignment="Left"/>
                                        <Button Style="{StaticResource LinkBtn}" Content="↻ 刷新" HorizontalAlignment="Right" Click="RefreshWindows"/>
                                    </Grid>
                                    <Button x:Name="WinBtn" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryBtn}" Click="WinApply_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock VerticalAlignment="Center">缩放所选窗口 <Run x:Name="WinInch" FontFamily="{StaticResource NumFont}" FontSize="17" Text="24.5″"/></TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,12"
                                               Text="窗口模式有轻微输入延迟，N 卡用户建议用「整个屏幕」。"/>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox x:Name="BackdropBox" Style="{StaticResource Switch}" Content="黑色背景" IsChecked="True" Click="WinOpt_Click"/>
                                        <CheckBox x:Name="TopmostBox" Style="{StaticResource Switch}" Content="窗口置顶" IsChecked="True" Margin="20,0,0,0" Click="WinOpt_Click"/>
                                    </StackPanel>
                                    <Border Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                        <ListBox x:Name="WindowList" BorderThickness="0" Background="Transparent"
                                                 ItemContainerStyle="{StaticResource WindowItem}" SelectionChanged="WindowList_SelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Border Width="28" Height="28" CornerRadius="5" Background="{Binding IconColor}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource NumFont}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" FontFamily="{StaticResource NumFont}" FontSize="11"
                                                                   Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <!-- 右：比例预览 -->
                        <Border x:Name="RightCol" Grid.Column="2" Style="{StaticResource Card}" Padding="18,16,18,14">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <c:TrackedText x:Name="PreviewCap" Style="{StaticResource Cap}" Prefix="03" Text="PREVIEW" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="PvSpec" HorizontalAlignment="Right" FontFamily="{StaticResource NumFont}" FontSize="11"
                                               Foreground="{DynamicResource Text3Brush}"/>
                                </Grid>

                                <Border DockPanel.Dock="Top" Margin="0,18,0,0" Background="{DynamicResource BezelBrush}" Padding="5" CornerRadius="5">
                                    <Grid x:Name="Screen" Width="356" Height="200" Background="Black" ClipToBounds="True">
                                        <Rectangle Fill="{StaticResource Hatch}"/>

                                        <!-- 游戏画面（四层视差 + 固定 HUD） -->
                                        <Grid x:Name="GameFrame" Width="356" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid ClipToBounds="True">
                                                <Viewbox Stretch="UniformToFill">
                                                    <Canvas x:Name="Scene" Width="1600" Height="900" ClipToBounds="True" TextOptions.TextFormattingMode="Ideal">
                                                        <Canvas x:Name="LySky">
                                                            <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
                                                            <Rectangle Canvas.Left="-120" Canvas.Top="-120" Width="1840" Height="1140">
                                                                <Rectangle.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#1E2B4D" Offset="0"/>
                                                                        <GradientStop Color="#6B5A8A" Offset="0.52"/>
                                                                        <GradientStop Color="#E7956A" Offset="0.72"/>
                                                                    </LinearGradientBrush>
                                                                </Rectangle.Fill>
                                                            </Rectangle>
                                                            <Ellipse Canvas.Left="780" Canvas.Top="300" Width="520" Height="520">
                                                                <Ellipse.Fill>
