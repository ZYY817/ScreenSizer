<Window x:Class="ScreenSizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSizer" Width="880" Height="620"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        Background="#F5F7FA" Foreground="#1B2430"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">

    <Border x:Name="RootBorder" Background="#F5F7FA" BorderBrush="#DCE3EC" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True" SnapsToDevicePixels="True">
        <Grid>
            <!-- 干净渐变底：浅底 + 角落氛围光，零模糊零依赖 -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FBFCFE" Offset="0"/>
                        <GradientStop Color="#F1F4F9" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="1,0" Center="1,0" RadiusX="1.1" RadiusY="1.4">
                        <GradientStop Color="#1F4C8DFF" Offset="0"/>
                        <GradientStop Color="#004C8DFF" Offset="0.75"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0,1" Center="0,1" RadiusX="0.9" RadiusY="1.1">
                        <GradientStop Color="#147C6CFF" Offset="0"/>
                        <GradientStop Color="#007C6CFF" Offset="0.7"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= 标题栏 + 导航 ================= -->
                <Grid Grid.Row="0" Margin="18,12,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 行1：logo + 名称 + 窗口按钮 -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    MouseLeftButtonDown="TitleBar_Drag">
                            <Border Width="30" Height="30" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4C8DFF" Offset="0"/>
                                        <GradientStop Color="#0A5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="⤢" FontSize="15" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ScreenSizer" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="｜屏幕缩小工具 · 为 FPS 玩家打造" FontSize="11"
                                       Foreground="#8A93A3" VerticalAlignment="Center" Margin="4,1,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-8,-6,0">
                            <Button Style="{StaticResource TitleBtn}" Content="—" Click="Min_Click" Width="40"/>
                            <Button Style="{StaticResource TitleBtn}" Content="□" Click="Max_Click" Width="40" FontSize="11"/>
                            <Button Style="{StaticResource TitleBtnClose}" Content="✕" Click="Close_Click" Width="44"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行2：导航胶囊 + 状态徽章 + 显示器 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="NavScale" Click="Nav_Click" Tag="Scale">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="缩放"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavGuide" Click="Nav_Click" Tag="Guide">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="使用说明"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSettings" Click="Nav_Click" Tag="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="设置"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavAbout" Click="Nav_Click" Tag="About">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="关于"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border x:Name="BackendChip" CornerRadius="10" Padding="9,3" Margin="0,0,10,0"
                                    Background="#E6F7EC" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="BackendChipText" FontSize="11" Foreground="#17803B" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ComboBox x:Name="MonitorCombo" Style="{StaticResource PillCombo}" MinWidth="190"
                                      SelectionChanged="MonitorCombo_SelectionChanged" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= 内容页 ================= -->
                <Grid Grid.Row="1" Margin="18,14,18,0">

                    <!-- ======== 缩放页 ======== -->
                    <Grid x:Name="PageScale">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 已应用状态横幅 -->
                        <Border x:Name="AppliedBanner" Grid.Row="0" Visibility="Collapsed"
                                Background="#E6F7EC" CornerRadius="9" Padding="12,8" Margin="0,0,0,10">
                            <TextBlock x:Name="AppliedText" FontSize="12.5" Foreground="#17803B" FontWeight="SemiBold"/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="360"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：控制区 -->
                            <Grid Grid.Column="0" Margin="6,6,30,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <Border Style="{StaticResource SegTrackB}" Margin="0" Padding="2">
                                        <UniformGrid Columns="2">
                                            <Button x:Name="SegScreen" Style="{StaticResource SegBtn}" Content="整个屏幕" Click="SegScreen_Click" FontWeight="SemiBold" Padding="14,4"/>
                                            <Button x:Name="SegWindow" Style="{StaticResource SegBtn}" Content="仅游戏窗口" Click="SegWindow_Click" Padding="14,4"/>
                                        </UniformGrid>
                                    </Border>
                                    <Border CornerRadius="8" Padding="8,3" Margin="12,0,0,0" Background="#EAF1FF" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#1677FF" Margin="0,0,5,0"/>
                                            <TextBlock Text="电竞模式" FontSize="11" Foreground="#1677FF" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid x:Name="ScreenPanel" Grid.Row="1" Margin="0,10,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="InchText" Text="24.5" FontSize="56" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI Variable Display" Foreground="#101828"/>
                                            <TextBlock Text="″" FontSize="20" Foreground="#667085"
                                                       VerticalAlignment="Top" Margin="4,14,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="InchSubText" FontSize="12.5" Foreground="#667085" Margin="2,0,0,10"/>
                                        <WrapPanel x:Name="ChipPanel" Margin="-2,0,0,8">
                                            <Button Style="{StaticResource ChipBtn}" Content="21.5&quot;" Tag="21.5" Click="QuickInch" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource ChipBtn}" Content="23&quot;" Tag="23" Click="QuickInch" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource ChipBtn}" Content="23.8&quot;" Tag="23.8" Click="QuickInch" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource ChipBtn}" Content="24&quot;" Tag="24" Click="QuickInch" Margin="0,0,8,8"/>
                                            <Button Style="{StaticResource ChipBtn}" Content="★ 24.5&quot;" Tag="24.5" Click="QuickInch" Margin="0,0,8,8"
                                                    ToolTip="CS / Valorant 职业赛标准尺寸，FPS 最佳选择"/>
                                            <Button Style="{StaticResource ChipBtn}" Content="25&quot;" Tag="25" Click="QuickInch" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                        <Slider x:Name="InchSlider" Style="{StaticResource IOSSlider}"
                                                SmallChange="0.1" LargeChange="0.5" Value="24.5"
                                                ValueChanged="InchSlider_ValueChanged" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                            <TextBlock Text="分辨率" FontSize="12" Foreground="#667085" VerticalAlignment="Center" Width="46"/>
                                            <ComboBox x:Name="ResCombo" Style="{StaticResource PillCombo}" MinWidth="150"
                                                      SelectionChanged="ResCombo_Changed"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PreviewText" Style="{StaticResource HintText}" Margin="2,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryBtn}" Content="▶  应用 24.5″" Click="Apply"/>
                                            <Button x:Name="RestoreBtn" Style="{StaticResource GhostBtn}" Content="↺  还原全屏" Margin="10,0,0,0" Padding="18,10" Click="Restore"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 仅游戏窗口 -->
                                <Grid x:Name="WindowPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="0">
                                        <TextBlock Text="游戏窗口" FontSize="13" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource GhostBtn}" Content="刷新" Padding="10,3" Margin="12,0,0,0" Click="RefreshWindows"/>
                                        <CheckBox x:Name="BackdropBox" Style="{StaticResource IOSSwitch}" Content="黑色背景" IsChecked="True" Margin="16,0,0,0"/>
                                        <CheckBox x:Name="TopmostBox" Style="{StaticResource IOSSwitch}" Content="置顶" IsChecked="True" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Margin="0,10,0,6" BorderBrush="#E4E8F0" BorderThickness="1"
                                            CornerRadius="8" Background="#FFFFFF">
                                        <ListBox x:Name="WindowList" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Background="Transparent" FontSize="12" Margin="2"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}" Grid.Row="2"
                                               Text="游戏窗口将去边框、缩放到所选尺寸并居中。窗口模式有轻微输入延迟。"/>
                                </Grid>
                            </Grid>

                            <!-- 右：显示器插画 -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <StackPanel>
                                    <Border Padding="9" Background="#0E141D" CornerRadius="13"
                                            HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28" Color="#0E141D"/>
                                        </Border.Effect>
                                        <Grid x:Name="PreviewPanel" Width="296" Height="170" Background="Black" ClipToBounds="True">
                                            <Grid x:Name="PreviewImage" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Width="296" Height="170">
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#3E6FCC" Offset="0"/>
                                                            <GradientStop Color="#1D3A7A" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid Width="34" Height="34" HorizontalAlignment="Center">
                                                        <Ellipse Stroke="#99FFFFFF" StrokeThickness="1.6"/>
                                                        <Rectangle Width="1.6" Height="44" Fill="#99FFFFFF" VerticalAlignment="Center"/>
                                                        <Rectangle Height="1.6" Width="44" Fill="#99FFFFFF" HorizontalAlignment="Center"/>
                                                        <Ellipse Width="4" Height="4" Fill="#CCFFFFFF"/>
                                                    </Grid>
                                                    <TextBlock Text="GAME" FontSize="15" FontWeight="Bold" Foreground="#E6FFFFFF"
                                                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Width="24" Height="16" Background="#151B26" HorizontalAlignment="Center"/>
                                    <Border Width="104" Height="7" Background="#1A2230" CornerRadius="3.5" HorizontalAlignment="Center"/>
                                    <Ellipse Width="180" Height="10" Fill="#0E141D" Opacity="0.18" HorizontalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="画面缩小后居中显示，四周为黑边" FontSize="10.5" Foreground="#98A2B3"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="目标画面" FontSize="10" Foreground="#98A2B3"/>
                                                <TextBlock x:Name="InfoResText" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="等效尺寸" FontSize="10" Foreground="#98A2B3"/>
                                                <TextBlock x:Name="InfoInchText" FontSize="13" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ======== 使用说明 ======== -->
                    <Grid x:Name="PageGuide" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="使用说明" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,2"/>
                            <TextBlock Text="三步上手，打 FPS 专用" FontSize="12" Foreground="#98A2B3" Margin="4,0,0,14"/>
                            <Border Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#EAF1FF" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#1677FF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,1,0,0">
                                        <TextBlock Text="选尺寸，点「应用」" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="拖滑块或点预设——整个屏幕立即缩小为居中画面，四周留黑边" FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#EAF1FF" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#1677FF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,1,0,0">
                                        <TextBlock Text="游戏设「全屏」" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="若游戏里有分辨率选项，选「桌面分辨率」或工具生成的自定义分辨率" FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#EAF1FF" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#1677FF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,1,0,0">
                                        <TextBlock Text="玩完点「还原全屏」" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="一键恢复原生分辨率和缩放模式，不会有残留" FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="#F5F9FF" CornerRadius="10" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 「仅游戏窗口」适合不支持驱动缩放的显卡：只缩选中窗口，有轻微输入延迟，休闲游戏可用。"
                                                   FontSize="11.5" Foreground="#475467" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GuideResText" FontSize="11.5" Foreground="#98A2B3" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======== 设置 ======== -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,2"/>
                            <TextBlock Text="启动、恢复与运行选项" FontSize="12" Foreground="#98A2B3" Margin="4,0,0,14"/>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#EAF1FF">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="通用" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="开机自启" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="登录 Windows 后自动启动本软件" FontSize="11.5" Foreground="#98A2B3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartBox" Grid.Column="1" Style="{StaticResource IOSSwitch}"
                                                  VerticalAlignment="Center"
                                                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#EAF1FF">
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="恢复与安全" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource WarnBtn}" Content="⚠  应急还原" Click="ForceRestore"/>
                                        <TextBlock Text="显示异常时，强制恢复到系统原始分辨率与缩放" FontSize="11.5"
                                                   Foreground="#98A2B3" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <Border Height="0.5" Background="{StaticResource CardBorder}"/>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="外部修改检测" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="检测到游戏修改分辨率时给出提示" FontSize="11.5" Foreground="#98A2B3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="DriftDetectBox" Grid.Column="1" Style="{StaticResource IOSSwitch}"
                                                  VerticalAlignment="Center" IsChecked="True"
                                                  Checked="DriftDetect_Changed" Unchecked="DriftDetect_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0" Padding="16,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#EAF1FF">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="运行日志" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Border Background="#F7F8FA" BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10,8">
                                        <TextBox x:Name="LogBox" Height="110" IsReadOnly="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                                 Background="Transparent" BorderThickness="0" Foreground="#475467"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======== 关于 ======== -->
                    <Grid x:Name="PageAbout" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5B9BFF" Offset="0"/>
                                        <GradientStop Color="#0A5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="#0A5CFF"/>
                                </Border.Effect>
                                <TextBlock Text="⤢" FontSize="30" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ScreenSizer" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
