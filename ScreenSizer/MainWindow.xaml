                    <Path x:Name="IntroBR" Data="M22,0 V22 H0" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0"/>
                </Canvas>
                <StackPanel x:Name="IntroCount" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                    <TextBlock x:Name="IntroNum" Text="27" FontFamily="{StaticResource NumLightFont}" FontSize="84"/>
                    <TextBlock Text="″" FontFamily="{StaticResource NumLightFont}" FontSize="32" Foreground="{DynamicResource AccentBrush}" Margin="4,14,0,0"/>
                </StackPanel>
                <StackPanel x:Name="IntroMark" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,236,0,0" Opacity="0">
                    <c:TrackedText Text="AIM" FontSize="13" FontWeight="Bold" Tracking="0.5" Foreground="{DynamicResource TextBrush}"/>
                    <c:TrackedText Text="FRAME" FontSize="13" FontWeight="Light" Tracking="0.5" Foreground="{DynamicResource Text2Brush}" Margin="6,0,0,0"/>
                </StackPanel>
                <Rectangle x:Name="IntroScan" Height="1" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" Opacity="0">
                    <Rectangle.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="{DynamicResource AccentColor}"/></Rectangle.Effect>
                    <Rectangle.RenderTransform><TranslateTransform x:Name="IntroScanT"/></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>

            <!-- 赞赏码放大层：点码弹出，点任意处关闭 -->
            <Grid x:Name="ZanLayer" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" MouseLeftButtonUp="ZanLayer_Close">
                <Border c:Cut.Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" Padding="26,20">
                    <StackPanel>
                        <TextBlock x:Name="ZanTitle" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Border Background="White" CornerRadius="10" Padding="10" Margin="0,12,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <Image x:Name="ZanImg" Height="430" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="手机扫码 · 点击任意处关闭" FontSize="11" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 提示：底部居中，不遮右侧预览卡片的说明文字 -->
            <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,84" Padding="14,8"
                    CornerRadius="4" Background="{DynamicResource TextBrush}" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="ToastT"/></Border.RenderTransform>
                <TextBlock x:Name="ToastText" FontSize="12" Foreground="{DynamicResource BgBrush}"/>
            </Border>
        </Grid>
    </Border>
</Window>
